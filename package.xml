<?xml version="1.0"?>
<package format="3">
  <name>smart_obstacle_avoidance</name>
  <version>0.1.0</version>
  <description>Simulated LiDAR obstacle detection and avoidance on Turtlesim (ROS 2, Python)</description>
  <maintainer email="suhanisrao1ga23is166@gmail.com">Suhani S Rao</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>turtlesim</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2service</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
